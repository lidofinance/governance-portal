{
  "name": "lido-governance-portal",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "dev": "NODE_ENV=development node server.mjs",
    "dev:ipfs": "IPFS_MODE=true next dev",
    "build": "NODE_OPTIONS='--no-warnings=ExperimentalWarning' next build",
    "build:analyze": "ANALYZE_BUNDLE=true yarn build",
    "build:ipfs": "IPFS_MODE=true yarn build && IPFS_MODE=true next export",
    "start": "NODE_ENV=production RUN_STARTUP_CHECKS=true node -r next-logger --no-warnings=ExperimentalWarning server.mjs",
    "lint": "eslint --ext ts,tsx,js,mjs .",
    "lint:fix": "yarn lint --fix",
    "types": "tsc --noEmit",
    "generate:ts-abi": "npx wagmi generate",
    "postinstall": "husky install && yarn typechain || true",
    "test:unit": "jest",
    "prepare": "husky",
    "build-events:local": "node --env-file=.env.local ./scripts/proposals/build-proposals-events.mjs",
    "validate-events": "node --env-file=.env.local ./scripts/proposals/validate-proposals-events.mjs"
  },
  "dependencies": {
    "@lidofinance/api-metrics": "^0.45.1",
    "@lidofinance/api-rpc": "^0.45.1",
    "@lidofinance/evm-script-decoder": "0.2.2",
    "@lidofinance/lido-ethereum-sdk": "4.6.0",
    "@lidofinance/lido-ui": "^3.31.0",
    "@lidofinance/next-api-wrapper": "^0.45.1",
    "@lidofinance/next-ip-rate-limit": "^0.45.1",
    "@lidofinance/next-pages": "^0.45.1",
    "@lidofinance/rpc": "^0.45.1",
    "@lidofinance/satanizer": "^0.45.1",
    "@tanstack/react-query": "^5.51.21",
    "@wagmi/cli": "^2.7.1",
    "copy-to-clipboard": "^3.3.1",
    "date-fns": "2.29.2",
    "dayjs": "1.11.13",
    "ethers": "^5.7.2",
    "fs-extra": "^10.1.0",
    "ipfs-only-hash": "^4.0.0",
    "lodash": "^4.17.21",
    "memory-cache": "^0.2.0",
    "ms": "^2.1.3",
    "next": "^12.3.4",
    "next-logger": "^3.0.2",
    "next-secure-headers": "^2.2.0",
    "nprogress": "^0.2.0",
    "prom-client": "^14.0.1",
    "raw-loader": "^4.0.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-error-boundary": "^4.0.13",
    "react-hook-form": "^7.45.2",
    "react-is": "^18.2.0",
    "react-markdown": "^8.0.7",
    "reef-knot": "7.4.2",
    "remark-gfm": "^3.0.1",
    "remove-markdown": "0.5.0",
    "styled-components": "^5.3.5",
    "tiny-invariant": "^1.1.0",
    "uuid": "^8.3.2",
    "viem": "2.31.3",
    "wagmi": "2.15.6"
  },
  "devDependencies": {
    "@commitlint/cli": "^17.4.4",
    "@commitlint/config-conventional": "^17.4.4",
    "@lidofinance/eslint-config": "^0.34.0",
    "@next/bundle-analyzer": "^13.2.4",
    "@next/eslint-plugin-next": "^13.4.13",
    "@svgr/webpack": "^8.0.1",
    "@typechain/ethers-v5": "^7.0.1",
    "@types/jest": "28.1.6",
    "@types/lodash": "^4.14.186",
    "@types/memory-cache": "0.2.2",
    "@types/ms": "^0.7.31",
    "@types/node": "^18.6.1",
    "@types/nprogress": "^0.2.0",
    "@types/react": "^18.2.22",
    "@types/remove-markdown": "0.3.1",
    "@types/styled-components": "^5.1.23",
    "@types/uuid": "^8.3.2",
    "@typescript-eslint/eslint-plugin": "^6.2.1",
    "@typescript-eslint/parser": "^6.2.1",
    "eslint": "^8.46.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-import-resolver-typescript": "^3.5.5",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "eslint-plugin-import": "^2.28.0",
    "eslint-plugin-jest": "^27.2.3",
    "@types/styled-system": "^5.1.17",
    "eslint-plugin-jsx-a11y": "^6.7.1",
    "eslint-plugin-promise": "^6.1.1",
    "eslint-plugin-react": "^7.33.1",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-sonarjs": "^0.20.0",
    "eslint-plugin-unicorn": "^48.0.1",
    "husky": "9.1.7",
    "jest": "^29.5.0",
    "lint-staged": "15.4.1",
    "prettier": "^3.0.1",
    "typechain": "^5.1.2",
    "typescript": "5.4.5",
    "url-loader": "^4.1.1",
    "webpack-preprocessor-loader": "^1.3.0"
  },
  "resolutions": {
    "postcss": "^8.4.31",
    "crypto-js": "^4.2.0",
    "preact": "^10.28.2"
  },
  "lint-staged": {
    "./**/*.{ts,tsx}": [
      "eslint --ignore-path .gitignore --max-warnings=0",
      "bash -c tsc --noEmit"
    ],
    "./**/*.{ts,tsx,css,md,json}": [
      "prettier --write"
    ]
  },
  "browserslist": [
    "> 1%, last 2 versions, not dead",
    "last 1 ios_saf major versions"
  ],
  "jest": {
    "transform": {
      "^.+\\.(ts|tsx)$": [
        "babel-jest",
        {
          "presets": [
            [
              "@babel/preset-env",
              {
                "targets": {
                  "node": "current"
                }
              }
            ],
            "@babel/preset-typescript"
          ]
        }
      ]
    },
    "moduleDirectories": [
      "node_modules",
      "."
    ],
    "moduleNameMapper": {
      "^expect$": "<rootDir>/node_modules/expect/build/index.js"
    }
  }
}
