{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "baseUrl": ".",
    "incremental": true,
    "paths": {
      "@easy-track/*": ["features/easy-track/*"],
      "@stonks/*": ["features/stonks/*"],
      "@dg/*": ["features/dual-governance/*"],
      "@vote/*": ["features/vote/*"]
    }
  },
  "include": ["**/*"],
  "exclude": ["node_modules"]
}
